# OrgTrace Production Configuration Template
# Copy this file to .env and supply actual values for your deployment.
# NEVER commit .env with real credentials to version control.

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
# Environment mode: production, staging, development, test
ORGTRACE_ENV=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ORGTRACE_LOG_LEVEL=INFO

# Emit structured JSON logs instead of human-readable text (true/false)
ORGTRACE_LOG_JSON=false

# ==============================================================================
# 2. PROVIDER CREDENTIALS & ENDPOINTS
# ==============================================================================
# Brave Search API Key for external search candidate discovery (optional)
# If omitted, discovery operates via registry/sitemap anchors only.
BRAVE_SEARCH_API_KEY=

# Base URL for Brave Search Web API
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Base URL for Brønnøysundregistrene Enhetsregisteret API
BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# Base URL for Regnskapsregisteret Annual Accounts API
BRREG_ACCOUNTS_BASE_URL=https://data.brreg.no/regnskapsregisteret/regnskap

# ==============================================================================
# 3. NETWORK & SAFETY POLICIES
# ==============================================================================
# Connection timeout in seconds
ORGTRACE_CONNECT_TIMEOUT=10.0

# Read/request timeout in seconds
ORGTRACE_READ_TIMEOUT=20.0

# Maximum number of retry attempts for retryable HTTP errors (429, 5xx)
ORGTRACE_MAX_RETRIES=3

# Base delay in seconds for exponential backoff
ORGTRACE_RETRY_BACKOFF=0.4

# Maximum allowed URL length to protect against buffer/memory exhaustion
ORGTRACE_MAX_URL_LENGTH=4096

# Strict DNS-level SSRF verification on outbound HTTP calls (true/false)
ORGTRACE_ENFORCE_DNS_CHECK=false

# ==============================================================================
# 4. EVALUATION & BATCH DEFAULTS
# ==============================================================================
# Maximum number of profiles per evaluation envelope
ORGTRACE_DEFAULT_ENVELOPE_COUNT=100

# Total network request budget for batch evaluation runs
ORGTRACE_DEFAULT_REQUEST_BUDGET=500

# Maximum execution runtime in seconds for batch runs
ORGTRACE_DEFAULT_RUNTIME_BUDGET=300.0

# Maximum cost budget in USD for batch runs
ORGTRACE_DEFAULT_COST_BUDGET=10.0
